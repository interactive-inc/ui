{
  "$schema": "node_modules/@biomejs/biome/configuration_schema.json",
  "formatter": {
    "indentStyle": "space"
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedImports": "error"
      },
      "nursery": {
        "useSortedClasses": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "semicolons": "asNeeded"
    }
  },
  "files": {
    "includes": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.json",
      "!public/r",
      "!out",
      "!dist",
      "!.void",
      "!.cloudflare",
      "!.wrangler",
      "!components/ui.base-maia/*",
      "!components/ui/*",
      "!lib/utils.ts",
      "!hooks/*",
      "!lib/highlighter.tsx",
      "!registry/components/ui/*",
      "!registry/hooks/*"
    ]
  }
}
