{
  "name": "open-registry",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "portless ui.inta.site vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "biome check . --fix --unsafe",
    "check": "tsgo --noEmit",
    "test": "vitest run",
    "registry:build": "bun scripts/build-llms.ts && biome format --write registry.json && shadcn build",
    "postinstall": "void prepare"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@shadcn/react": "^0.3.1",
    "@ui-sdk/core": "^0.1.0-beta.2",
    "@ui-sdk/react": "^0.1.0-beta.2",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "hono": "^4.13.18",
    "input-otp": "^1.5.0",
    "lucide-react": "^0.487.0",
    "react": "19.1.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.1.0",
    "react-resizable-panels": "^4.23.0",
    "recharts": "3.8.0",
    "shiki": "^4.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "@vitejs/plugin-react": "^6.3.0",
    "@void/react": "1.9.1",
    "jsdom": "^31.0.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "void": "1.9.1"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.14",
      "onFail": "download"
    }
  }
}
